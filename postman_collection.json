{
  "info": {
    "name": "Dukaan-Server API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for Dukaan-Server backend"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpId\": \"{{otpId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Merchants",
      "item": [
        {
          "name": "Create Merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerUserId\": \"{{customerId}}\",\n  \"names\": {\n    \"en\": \"Ali Store\",\n    \"ur\": \"علی دکان\"\n  },\n  \"shopAddress\": {\n    \"text\": {\n      \"en\": \"House 12, Street X\",\n      \"ur\": \"گھر 12، سڑک X\"\n    },\n    \"street\": \"Street X\"\n  },\n  \"geo\": {\n    \"lat\": 33.148,\n    \"lng\": 73.751\n  },\n  \"deliveryRadiusMeters\": 3000,\n  \"deliveryCharge\": 60,\n  \"openingHours\": [\n    {\n      \"day\": \"mon\",\n      \"slots\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"21:00\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants"]
            }
          }
        },
        {
          "name": "Get Nearby Merchants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants?lat=33.148&lng=73.751&radius=5000&open=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants"],
              "query": [
                {
                  "key": "lat",
                  "value": "33.148"
                },
                {
                  "key": "lng",
                  "value": "73.751"
                },
                {
                  "key": "radius",
                  "value": "5000"
                },
                {
                  "key": "open",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Merchant by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}"]
            }
          }
        },
        {
          "name": "Update Merchant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryCharge\": 70\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}"]
            }
          }
        },
        {
          "name": "Verify Merchant (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"notes\": \"Approved for testing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"PROD001\",\n  \"names\": {\n    \"en\": \"Fresh Milk\",\n    \"ur\": \"تازہ دودھ\"\n  },\n  \"description\": {\n    \"en\": \"Fresh cow milk, 1 liter\",\n    \"ur\": \"تازہ گائے کا دودھ، 1 لیٹر\"\n  },\n  \"images\": [\n    {\n      \"url\": \"https://example.com/milk.jpg\",\n      \"publicId\": \"milk-1\"\n    }\n  ],\n  \"price\": 250,\n  \"stock\": 100,\n  \"unit\": \"liter\",\n  \"category\": \"Dairy\",\n  \"tags\": [\"dairy\", \"milk\", \"fresh\"],\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "products"]
            }
          }
        },
        {
          "name": "Get Products by Merchant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/products?page=1&limit=20&q=milk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "q",
                  "value": "milk"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 260,\n  \"stock\": 90\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Client-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"customerSnapshot\": {\n    \"name\": \"Test Customer\",\n    \"phone\": \"+923001234567\",\n    \"addressText\": \"House 123, Street Y\",\n    \"geo\": {\n      \"lat\": 33.149,\n      \"lng\": 73.752\n    },\n    \"note\": \"Please deliver in the morning\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"qty\": 2\n    }\n  ],\n  \"paymentMethod\": \"COD\",\n  \"deliverySlot\": {\n    \"date\": \"2024-01-15\",\n    \"window\": \"10:00-12:00\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Merchant Accept Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accepted\": true,\n  \"notes\": \"Order accepted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/merchant-accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "merchant-accept"]
            }
          }
        },
        {
          "name": "Customer Confirm Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/customer-confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "customer-confirm"]
            }
          }
        },
        {
          "name": "Assign Rider",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{riderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/assign-rider",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "assign-rider"]
            }
          }
        },
        {
          "name": "Rider Update Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\",\n  \"podImageUrl\": \"https://example.com/pod.jpg\",\n  \"otpProvided\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/rider-update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "rider-update"]
            }
          }
        },
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?status=PLACED&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "PLACED"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Riders",
      "item": [
        {
          "name": "Create Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Rider\",\n  \"phone\": \"+923009876543\",\n  \"email\": \"rider@example.com\",\n  \"vehicleType\": \"Motorcycle\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/riders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "riders"]
            }
          }
        },
        {
          "name": "Get Riders by Merchant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/riders?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "riders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "COD Ledger",
      "item": [
        {
          "name": "Get COD Ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/cod-ledger?status=PENDING&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "cod-ledger"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create Settlement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ledgerIds\": [\"{{ledgerId1}}\", \"{{ledgerId2}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}", "settlements"]
            }
          }
        }
      ]
    }
  ]
}

